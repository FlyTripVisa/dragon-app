{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "dragon-app",

  "main": "src/index.ts",

  "compatibility_date": "2026-09-30",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "ai": {
    "binding": "AI"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}